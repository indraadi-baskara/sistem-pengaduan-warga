# Copy to .env and fill real values (never commit .env)
# Local dev: leave DATABASE_URL empty to use file:./data/lapor.db (no Turso needed)
# Turso/prod: set libSQL URL + auth token
DATABASE_URL=libsql://your-db-username.turso.io
TURSO_AUTH_TOKEN=eyJ...
# Netlify: set NUXT_DATABASE_URL + TURSO_AUTH_TOKEN (NUXT_ prefix = Nitro runtime, not inlined)
NUXT_DATABASE_URL=libsql://your-db-username.turso.io
NUXT_SESSION_PASSWORD= # openssl rand -base64 32 (min 32 chars)
# Optional local override:
# DATABASE_URL=file:./data/lapor.db
